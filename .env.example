# ==============================================================================
# NovaChat — Production Environment Configuration (.env.example)
# ==============================================================================
# NOTE: All variables prefixed with VITE_ are embedded into the client bundle at
# build time. Never place secret service-role keys or database passwords here.
# ==============================================================================

# ------------------------------------------------------------------------------
# CATEGORY A: Public Frontend Build-Time Variables (Supabase Infrastructure)
# ------------------------------------------------------------------------------
# Supabase project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase public anonymous API key (Protected by PostgreSQL Row Level Security)
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key

# Google OAuth Web Client ID for social sign-in
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# CATEGORY B: Tactical Radar & Map Services (Mappls / MapmyIndia)
# ------------------------------------------------------------------------------
# MapmyIndia / Mappls Vector Maps API Keys
VITE_MAPMYINDIA_API_KEY=your-mapmyindia-vector-api-key
VITE_MAPPLS_API_KEY=your-mappls-rest-api-key

# ------------------------------------------------------------------------------
# CATEGORY C: WebRTC STUN/TURN Calling Infrastructure
# ------------------------------------------------------------------------------
# Metered.ca dynamic credentials REST API domain & API key (Optional, recommended)
VITE_METERED_DOMAIN=your-app-subdomain.metered.live
VITE_METERED_API_KEY=your-metered-api-key

# Static TURN relay servers (Self-Hosted Coturn or static Metered servers)
# Supports comma-separated endpoints (e.g. turn:relay.example.com:80,turns:relay.example.com:443)
VITE_TURN_SERVER_URL=turn:global.relay.metered.ca:80,turn:global.relay.metered.ca:443,turns:global.relay.metered.ca:443?transport=tcp
VITE_TURN_USERNAME=your-turn-username
VITE_TURN_CREDENTIAL=your-turn-password

# ------------------------------------------------------------------------------
# CATEGORY D: CI/CD & Cloudflare Pages Secrets (Configure in GitHub Secrets / Wrangler)
# ------------------------------------------------------------------------------
# CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
# CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-DO-NOT-EXPOSE-IN-FRONTEND
