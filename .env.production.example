# NovaChat Frontend - Production Environment Variables

# Supabase Infrastructure
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google OAuth
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id

# MapmyIndia / Mappls Vector Maps SDK Key (GodMap Tactical Radar)
VITE_MAPMYINDIA_API_KEY=your-mapmyindia-key
VITE_MAPPLS_API_KEY=your-mappls-key

# WebRTC / TURN Server (Metered.ca or Coturn VPS)
VITE_METERED_DOMAIN=your-app.metered.live
VITE_METERED_API_KEY=your-metered-api-key
VITE_TURN_SERVER_URL=turn:global.relay.metered.ca:80,turn:global.relay.metered.ca:443
VITE_TURN_USERNAME=your-turn-username
VITE_TURN_CREDENTIAL=your-turn-password

